{
    "name": "reexolon",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Exolon — TypeScript/Preact reconstruction with original and remastered graphics",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "http-server ./dist -c-1 -p 8091 -a 127.0.0.1",
        "predev": "npm run build -- --dev",
        "build": "node --experimental-strip-types ./tools/build/index.mjs",
        "graphics:loading-screens": "node --experimental-strip-types ./tools/graphics/loading-screens.mjs",
        "build:preferences": "node --experimental-strip-types ./tools/build/preferences.mjs",
        "build:legacy": "node --experimental-strip-types ./tools/build/legacy.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
        "eslint": "eslint .",
        "unit-test": "node --experimental-strip-types --test ./tests/unit/*.test.ts",
        "test": "node --run format:check && node --run typecheck && node --run eslint && node --run stylelint && node --run knip && node --run unit-test",
        "check:browser": "node --experimental-strip-types ./tests/browser/run.ts",
        "precheck:browser": "npm run build",
        "recovery:inspect": "node --experimental-strip-types ./tools/recovery/inspect.mjs",
        "recovery:c64": "node --experimental-strip-types ./tools/recovery/c64.mjs",
        "recovery:sharp": "node --experimental-strip-types ./tools/recovery/sharp.mjs",
        "recovery:cpc": "node --experimental-strip-types ./tools/recovery/cpc.mjs",
        "graphics:zx": "node --experimental-strip-types ./tools/graphics/zx.mjs",
        "graphics:c64": "node --experimental-strip-types ./tools/graphics/c64.mjs",
        "graphics:sharp": "node --experimental-strip-types ./tools/graphics/sharp.mjs",
        "graphics:cpc": "node --experimental-strip-types ./tools/graphics/cpc.mjs",
        "audio:zx": "node --experimental-strip-types ./tools/audio/zx.mjs",
        "audio:cheat-confirmation": "node --experimental-strip-types ./tools/audio/cheat-confirmation.mjs",
        "audio:c64": "node --experimental-strip-types ./tools/audio/c64.mjs",
        "audio:sharp": "node --experimental-strip-types ./tools/audio/sharp.mjs",
        "audio:cpc": "node --experimental-strip-types ./tools/audio/cpc.mjs",
        "audio:gameboy": "node --experimental-strip-types ./tools/audio/gameboy.mjs",
        "audio:compress": "node --experimental-strip-types ./tools/audio/compress.mjs",
        "audio:arrange": "node --experimental-strip-types ./tools/audio/arrange.mjs",
        "build:native": "node --experimental-strip-types ./tools/build/native.mjs",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "recovery:amiga": "node --experimental-strip-types ./tools/recovery/amiga.mjs",
        "graphics:amiga": "node --experimental-strip-types ./tools/graphics/amiga.mjs",
        "audio:amiga": "node --experimental-strip-types ./tools/audio/amiga.mjs",
        "model:amiga": "node --experimental-strip-types ./tools/recovery/amiga-model.mjs",
        "recovery:atari-st": "node --experimental-strip-types ./tools/recovery/atari-st.mjs",
        "model:atari-st": "node --experimental-strip-types ./tools/recovery/atari-st-model.mjs",
        "graphics:atari-st": "node --experimental-strip-types ./tools/graphics/atari-st.mjs",
        "audio:atari-st": "python3 ./tools/audio/atari-st.py",
        "knip": "knip --files --no-progress",
        "stylelint": "stylelint \"src/**/*.css\" --max-warnings 0",
        "stylelint:fix": "npm run stylelint -- --fix"
    },
    "devDependencies": {
        "@babel/core": "7.29.13",
        "@babel/preset-env": "7.29.7",
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.5",
        "@types/three": "0.187.0",
        "autoprefixer": "10.6.2",
        "classnames": "2.5.1",
        "core-js": "3.51.0",
        "eslint": "10.14.0",
        "globals": "17.14.0",
        "http-server": "14.1.1",
        "knip": "6.47.0",
        "lyam": "3.2.3",
        "playwright": "1.65.0",
        "postcss": "8.5.32",
        "preact": "11.2.0",
        "preact-render-to-string": "6.8.3",
        "prettier": "3.10.1",
        "rolldown": "1.3.0",
        "show-js-error": "4.1.3",
        "stylelint": "17.16.0",
        "stylelint-config-recommended": "18.0.0",
        "terser": "5.51.2",
        "three": "0.187.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "whatwg-fetch": "3.6.20"
    }
}
